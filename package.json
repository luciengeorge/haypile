{
  "name": "bookmarks",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "dotenv -e .env.local -- sh -c \"NODE_OPTIONS='--import ./instrument.server.mjs' vite dev --port 3000\"",
    "predev": "test -d convex/_generated && pnpm auth:generate || true",
    "convex": "convex dev",
    "preconvex": "test -d convex/_generated && pnpm auth:generate || true",
    "auth:generate": "pnpm dlx @better-auth/cli@latest generate --config convex/betterAuth/auth.ts --output ./convex/betterAuth/schema.ts -y",
    "auth:check": "pnpm auth:generate && git diff --exit-code -- convex/betterAuth/schema.ts",
    "build": "vite build && if [ -d .output/server ]; then cp instrument.server.mjs .output/server; fi",
    "preview": "vite preview",
    "start": "node --import ./.output/server/instrument.server.mjs .output/server/index.mjs",
    "email:dev": "email dev --dir ./convex/email/templates --port 3001",
    "email:export": "email export --dir ./convex/email/templates --outDir ./.email-out",
    "spike": "dotenv -e .env.local -- tsx scripts/spike-redcar.ts",
    "test": "vitest run",
    "lint": "oxfmt src && oxlint src",
    "lint:check": "oxfmt --check src && oxlint src",
    "format:check": "oxfmt --check .",
    "format": "oxfmt .",
    "typecheck": "tsgo --noEmit"
  },
  "dependencies": {
    "@ai-sdk/openai": "^3.0.60",
    "@ai-sdk/react": "^3.0.177",
    "@base-ui/react": "^1.4.1",
    "@convex-dev/action-cache": "^0.3.0",
    "@convex-dev/better-auth": "^0.12.2",
    "@convex-dev/polar": "^0.9.1",
    "@convex-dev/rag": "^0.7.2",
    "@convex-dev/rate-limiter": "^0.3.2",
    "@convex-dev/react-query": "^0.1.0",
    "@fontsource-variable/fraunces": "^5.2.9",
    "@fontsource-variable/geist": "^5.2.8",
    "@google/genai": "^2.7.0",
    "@hugeicons/core-free-icons": "^4.1.1",
    "@hugeicons/react": "^1.1.6",
    "@posthog/react": "^1.9.0",
    "@react-email/components": "^1.0.12",
    "@sentry/tanstackstart-react": "^10.51.0",
    "@tailwindcss/vite": "^4.2.1",
    "@tanstack/react-devtools": "^0.10.0",
    "@tanstack/react-form": "^1.29.1",
    "@tanstack/react-query": "^5.100.9",
    "@tanstack/react-query-devtools": "^5.100.9",
    "@tanstack/react-router": "^1.167.4",
    "@tanstack/react-router-devtools": "^1.166.9",
    "@tanstack/react-router-ssr-query": "^1.166.9",
    "@tanstack/react-start": "^1.166.15",
    "@tanstack/router-plugin": "^1.166.13",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "ai": "^6.0.175",
    "better-auth": "^1.6.9",
    "change-case": "^5.4.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "convex": "^1.37.0",
    "next-themes": "^0.4.6",
    "nitro": "latest",
    "openai": "^6.36.0",
    "posthog-js": "^1.372.8",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-email": "^6.0.8",
    "resend": "^6.12.2",
    "shadcn": "^4.6.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.1",
    "tw-animate-css": "^1.4.0",
    "vite-tsconfig-paths": "^5.1.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@react-email/ui": "6.0.8",
    "@tailwindcss/typography": "^0.5.19",
    "@tanstack/devtools-vite": "^0.6.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.19.15",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript/native-preview": "7.0.0-dev.20260505.1",
    "@vitejs/plugin-react": "^5.2.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "dotenv-cli": "^11.0.0",
    "jsdom": "^27.4.0",
    "oxfmt": "^0.47.0",
    "oxlint": "^1.62.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "^3.2.4",
    "web-vitals": "^5.1.0"
  }
}
