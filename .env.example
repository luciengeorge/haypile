# Copy to .env.local and fill in. Never commit .env.local.

# === App ===
APP_NAME="My App"
VITE_APP_NAME="my-app"           # used as PostHog "app" property
SITE_URL="http://localhost:3000"

# === Secrets (generate with: openssl rand -hex 32) ===
BETTER_AUTH_SECRET=
TOAST_SECRET=                    # ≥32 chars

# === Convex (from `npx convex dev`) ===
VITE_CONVEX_URL=                 # https://xxx.convex.cloud
VITE_CONVEX_SITE_URL=            # https://xxx.convex.site (HTTP actions URL)

# === OpenAI (optional — template RAG; not used by multimodal search) ===
OPENAI_API_KEY=

# === gemini-embedding-2 (multimodal search engine — REQUIRED) ===
# gemini-embedding-2 is VERTEX-ONLY and rejects plain API keys, so it needs real
# Google auth. Two paths:
#
# LOCAL DEV — Application Default Credentials (no key file):
#   gcloud auth application-default login   (personal account)
#   gcloud auth application-default set-quota-project YOUR_PROJECT
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global      # gemini-embedding-2 is global/us/eu only — NOT regional
#
# CONVEX (cloud functions can't use local gcloud) — inline service-account JSON.
# Set as a Convex env var, NOT here:  npx convex env set GOOGLE_SERVICE_ACCOUNT_JSON "$(cat sa.json)"
# Locally you can leave this unset (ADC covers it). Takes precedence if present.
GOOGLE_SERVICE_ACCOUNT_JSON=
#
# Express-mode API key — does NOT work with gemini-embedding-2 (kept for other APIs).
VERTEX_API_KEY=

# === Source APIs (fill as each adapter is wired) ===
# X / Twitter (OAuth2 PKCE, bookmark.read) — paid, $0.001/owned-read
X_CLIENT_ID=
X_CLIENT_SECRET=
# GitHub (OAuth, read:user)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# YouTube (uses Google OAuth below + Data API key)
YOUTUBE_API_KEY=
# Pinterest (OAuth v5 — requires app review)
PINTEREST_CLIENT_ID=
PINTEREST_CLIENT_SECRET=
# Reddit (OAuth, history — commercial license required before launch)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# === Resend (transactional email) ===
RESEND_API_KEY=
RESEND_FROM_EMAIL=               # noreply@yourdomain.com — must be a verified domain

# === Email branding (all optional) ===
EMAIL_LOGO_URL=                  # header logo image URL (falls back to APP_NAME text)
BRAND_COLOR=                     # hex for buttons/accents, e.g. #4f46e5 (default #0a0a0a)
SUPPORT_EMAIL=                   # help/reply-to address (falls back to RESEND_FROM_EMAIL)
EMAIL_SIGNOFF=                   # signature line, e.g. "— Lucien, founder of MyApp"

# === Polar (billing — Merchant of Record) ===
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=
POLAR_ORGANIZATION_ID=
POLAR_PRODUCT_STARTER=           # Polar product ID for the Starter plan
POLAR_PRODUCT_PRO=               # Polar product ID for the Pro plan
POLAR_SERVER=production          # production | sandbox
BILLING_PROVIDER=polar           # polar | stripe (stripe adapter stubbed)

# === Stripe (only if BILLING_PROVIDER=stripe) ===
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# === Admin / impersonation ===
# Comma-separated list of user IDs (NOT emails) granted admin powers.
# Sign up first → look up your _id from the Convex dashboard → paste here → restart.
ADMIN_USER_IDS=

# === OAuth (Google active in V1, Apple stubbed) ===
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
VITE_GOOGLE_OAUTH_ENABLED=1   # toggles the "Continue with Google" button in the UI
# APPLE_CLIENT_ID=
# APPLE_CLIENT_SECRET=
# APPLE_BUNDLE_ID=
# VITE_APPLE_OAUTH_ENABLED=1

# === Sentry (optional) ===
VITE_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=               # for source map upload during build

# === PostHog (optional) ===
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://eu.i.posthog.com

# === Google Analytics (optional) ===
VITE_GA_MEASUREMENT_ID=          # G-XXXXXXXXXX
